{
  "name": "calix-pass",
  "version": "0.1.0",
  "private": true,
  "description": "Secure password manager with KDBX support",
  "author": "Sebastian Flores Peralta",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "package": "npm run package:win",
    "package:win": "electron-builder --config config/electron-builder.yml --win --publish never",
    "package:win:dir": "electron-builder --config config/electron-builder.yml --win --dir",
    "package:win:publish": "electron-builder --config config/electron-builder.yml --win --publish always",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "fflate": "^0.8.0",
    "hash-wasm": "^4.11.0",
    "@stablelib/chacha": "^2.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-vite": "^2.0.0",
    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
